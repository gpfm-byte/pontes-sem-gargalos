# Conexão com o PostgreSQL + TimescaleDB local (peer auth via socket, sem senha).
# O bootstrap cria o role com o nome do usuário do SO e o banco "pontes".
DATABASE_URL=postgresql:///pontes?host=/var/run/postgresql

# Origens liberadas no CORS (front em dev). Separadas por vírgula.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:5175

# Fonte CTTU (dados abertos Recife) — usado pelo ingest.
CTTU_BASE=https://dados.recife.pe.gov.br
CTTU_RESOURCE=3e67a327-db30-4d4c-bd44-928e26e33c3f
CTTU_DATA=2018-08-28
