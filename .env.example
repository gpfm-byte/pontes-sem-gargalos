# Fonte de dados do dashboard:
#   mock — dados sintéticos (padrão)
#   cttu — proxy direto do dado aberto da CTTU (vite.config.ts)
#   api  — back-end próprio (pasta backend/)
VITE_DATA_SOURCE=api

# URL do back-end quando VITE_DATA_SOURCE=api
VITE_API_URL=http://localhost:8000/api

# Chave do Google Maps (client-side). Restrinja por referrer no Google Cloud.
VITE_GOOGLE_MAPS_KEY=
